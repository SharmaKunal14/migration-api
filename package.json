{
  "name": "migration-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "build": "npm run build:services && npm run build:web",
    "build:services": "node scripts/build-services.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "check": "npm run format:check && npm run docs:lint && npm run lint && npm run typecheck && npm run contracts:validate && npm run secrets:scan && npm test && npm run build",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#coverage\" \"#dist\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "@aws-sdk/client-secrets-manager": "3.1094.0",
    "@aws-sdk/client-sfn": "3.1094.0",
    "@aws-sdk/client-sts": "3.1094.0",
    "@supabase/supabase-js": "2.110.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.4",
    "kysely": "0.29.4",
    "openai": "6.49.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
