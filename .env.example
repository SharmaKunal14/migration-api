# Public browser configuration. These values are not secrets.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key

# Service configuration. Supply through the deployment environment.
APP_ENVIRONMENT=development
AWS_REGION=replace-with-recorded-region
ARTIFACT_BUCKET=replace-with-artifact-bucket
ARTIFACT_KMS_KEY_ARN=replace-with-kms-key-arn
DATABASE_SECRET_ARN=replace-with-runtime-database-secret-arn
OPENAI_MODEL=gpt-5.6-sol
SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
STATE_MACHINE_ARN=replace-with-state-machine-arn
OPENAI_IDENTITY_PROVIDER_ID=replace-with-openai-wif-provider-id
OPENAI_SERVICE_ACCOUNT_ID=replace-with-openai-service-account-id
OPENAI_WIF_AUDIENCE=https://api.openai.com/v1
OPENAI_PROJECT_ALIAS=development-agent
