{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration-api.example/schemas/v1/tool.schema.json",
  "title": "Migration API agent tool definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "description",
    "strict",
    "allowedAgents",
    "allowedPhases",
    "requiredRunStates",
    "sideEffect",
    "retryClass",
    "limits",
    "evidencePolicy",
    "inputSchema",
    "outputSchema"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512
    },
    "strict": {
      "const": true
    },
    "allowedAgents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["change_intelligence", "impact_analysis", "migration"]
      }
    },
    "allowedPhases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,63}$"
      }
    },
    "requiredRunStates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": ["running", "planning", "patching", "repairing"]
      }
    },
    "sideEffect": {
      "enum": ["none", "workspace_only"]
    },
    "retryClass": {
      "enum": ["never", "transient_safe", "idempotent"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "timeoutMs"],
      "properties": {
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    },
    "evidencePolicy": {
      "enum": ["none", "metadata", "artifact"]
    },
    "inputSchema": {
      "$ref": "#/$defs/strictObjectSchema"
    },
    "outputSchema": {
      "$ref": "#/$defs/strictObjectSchema"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "strictObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "additionalProperties": {
            "type": "object"
          }
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    }
  }
}
