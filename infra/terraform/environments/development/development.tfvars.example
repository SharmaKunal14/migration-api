aws_region        = "replace-with-recorded-region"
owner             = "replace-with-owner"
product_domain    = "replace-with-development-hostname"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"

supabase_url          = "https://project-ref.supabase.co"
supabase_jwt_issuer   = "https://project-ref.supabase.co/auth/v1"
supabase_jwt_audience = "authenticated"
supabase_jwks_url     = "https://project-ref.supabase.co/auth/v1/.well-known/jwks.json"

database_secret_arn                   = "arn:aws:secretsmanager:region:account:secret:runtime-db"
database_secret_kms_key_arn           = "arn:aws:kms:region:account:key/runtime-secret-key"
database_migration_secret_arn         = "arn:aws:secretsmanager:region:account:secret:migration-db"
database_migration_secret_kms_key_arn = "arn:aws:kms:region:account:key/migration-secret-key"
github_webhook_secret_arn              = "arn:aws:secretsmanager:region:account:secret:github-webhook"
github_webhook_secret_kms_key_arn      = "arn:aws:kms:region:account:key/github-webhook-secret-key"
github_app_secret_arn                  = "arn:aws:secretsmanager:region:account:secret:github-app"
github_app_secret_kms_key_arn          = "arn:aws:kms:region:account:key/github-app-secret-key"
github_app_slug                        = "replace-with-github-app-slug"

openai_identity_provider_id = "replace-with-development-wif-provider-id"
openai_service_account_id   = "replace-with-development-service-account-id"
openai_model                = "gpt-5.6-sol"
openai_project_alias        = "development-agent"

agent_image_digest    = "sha256:replace-with-64-lowercase-hex-characters"
migrator_image_digest = "sha256:replace-with-64-lowercase-hex-characters"
source_fetcher_image_digest = "sha256:replace-with-64-lowercase-hex-characters"
vendor_fetcher_image_digest = "sha256:replace-with-64-lowercase-hex-characters"
change_intelligence_agent_image_digest = "sha256:replace-with-64-lowercase-hex-characters"
change_intelligence_openai_identity_provider_id = "replace-with-dedicated-change-intelligence-provider-id"
change_intelligence_openai_service_account_id = "replace-with-dedicated-change-intelligence-service-account-id"
impact_analysis_agent_image_digest = "sha256:replace-with-64-lowercase-hex-characters"
impact_analysis_openai_identity_provider_id = "replace-with-dedicated-impact-analysis-provider-id"
impact_analysis_openai_service_account_id = "replace-with-dedicated-impact-analysis-service-account-id"
